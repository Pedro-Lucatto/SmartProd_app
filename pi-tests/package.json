{
  "name": "smartprod-pi-tests",
  "version": "1.0.0",
  "description": "Suite de Testes Automatizados do Projeto Integrador (Jest, Supertest, Cypress)",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "jest --testPathPattern=src/unit",
    "test:api": "jest --testPathPattern=src/integration --runInBand",
    "test:e2e": "cypress run",
    "cypress:open": "cypress open"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "cypress": "^14.1.0",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "docx": "^9.15.4"
  }
}
