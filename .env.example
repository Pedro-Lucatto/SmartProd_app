# ==============================================================================
# SmartProd Environment Configuration Template (.env.example)
# Duplicate to .env for local development or configure in GCP Secret Manager/Cloud Run
# ==============================================================================

# Database Configuration (Local PostgreSQL Docker or GCP Cloud SQL)
POSTGRES_DB=SmartProd
POSTGRES_USER=smartprod
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432
# For GCP Cloud Run with Cloud SQL Unix Socket, configure:
# DB_CONNECTION_STRING=Host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME;Database=SmartProd;Username=smartprod;Password=YOUR_PASSWORD

# Security & Authentication (JWT Bearer)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=SmartProd
JWT_EXPIRES_IN_DAYS=7

# CORS Allowed Origins (Comma-separated list or * for development)
# Examples: http://localhost:5173,http://localhost:3000,https://smartprod-frontend-xxxxxx.a.run.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Backend API Configuration
BACKEND_PORT=5481
ADMIN_INITIAL_EMAIL=admin@smartprod.local
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-secret-of-at-least-12-characters

# Optional Platform SuperAdmin Bootstrap
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# OpenTelemetry / Observability (Optional)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Frontend Configuration
# Leave empty for same-origin reverse proxy through Nginx, or specify backend URL
VITE_API_URL=
FRONTEND_PORT=80
